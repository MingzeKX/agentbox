# ---------------------------------------------------------------------------
# agentbox configuration.  Copy to .env and edit.
# Every setting is read by agent.config.Settings (env prefix AGENT_).
# ---------------------------------------------------------------------------

# --- PostgreSQL (runs natively inside the Debian platform VM, no Docker) ----
# ssl=disable: PostgreSQL is local; without it asyncpg emulates libpq and tries
# to read ~/.postgresql/postgresql.key, which the service user may not be able to.
AGENT_DB_URL=postgresql+asyncpg://agent:agent@127.0.0.1:5432/agentbox?ssl=disable

# --- AI service (FastAPI, inside the Debian platform VM) -------------------
AGENT_AI_HOST=0.0.0.0
AGENT_AI_PORT=8090

# --- Control plane (FastAPI, on the Windows host, owns QEMU) ---------------
AGENT_CONTROL_HOST=0.0.0.0
AGENT_CONTROL_PORT=8091
# How the AI service (inside the Debian guest) reaches the Windows host:
# QEMU user networking exposes the host as 10.0.2.2.
AGENT_CONTROL_URL=http://10.0.2.2:8091
# Shared secret required by the control plane (send it as X-Agent-Token).
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
AGENT_CONTROL_SECRET=

# --- LLM (OpenAI compatible) ----------------------------------------------
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=sk-replace-me
AGENT_LLM_MODEL=deepseek-chat
AGENT_LLM_TIMEOUT_S=180

# --- Embeddings (1024 dims for both backends; do not change dimension) -----
# local    -> BAAI/bge-m3 via sentence-transformers (pip install -e ".[local-embed]")
# dashscope-> Alibaba text-embedding-v4 (1024 dims)
AGENT_EMBEDDING_BACKEND=local
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_EMBEDDING_DIM=1024
AGENT_EMBEDDING_BATCH=16
# bge-m3 weights (~2.3 GB) download on first use. In CN, uncomment to use a mirror.
# HF_ENDPOINT=https://hf-mirror.com
AGENT_DASHSCOPE_API_KEY=
AGENT_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
AGENT_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- QEMU / sandbox -------------------------------------------------------
# Leave empty to auto-discover: AGENT_QEMU_DIR, <project>/qemu, then PATH.
AGENT_QEMU_DIR=
AGENT_SANDBOX_DIR=
# kvm | whpx | tcg | auto
AGENT_SANDBOX_ACCEL=auto
# CPU model. Empty = automatic: kvm->host, whpx->qemu64, tcg->max.
# WHPX on Windows CANNOT use host/max (guest dies with 'Unexpected VP exit code 4').
AGENT_SANDBOX_CPU=
AGENT_SANDBOX_POOL_SIZE=2
AGENT_SANDBOX_MAX_VMS=4
AGENT_SANDBOX_VM_MEMORY_MB=768
AGENT_SANDBOX_VM_CPUS=2
AGENT_SANDBOX_BOOT_TIMEOUT_S=180
AGENT_SANDBOX_IDLE_REAP_S=1800
AGENT_SANDBOX_SESSION_TTL_S=7200
# Windows Job Object limits for each QEMU process (bytes); 0 disables.
AGENT_SANDBOX_JOB_MEMORY_BYTES=1610612736
AGENT_SANDBOX_JOB_MAX_PROCESSES=256

# --- platform VM port forwards (loopback only, off by default) --------------
# Read by deploy/windows/run-platform-vm.ps1; restart the platform VM to apply.
# Single ports / inclusive ranges, comma separated, e.g. 2121,30000-30010.
# Refused: an explicit bind address, and 445/139 (this host owns SMB).
AGENT_PLATFORM_PORTS=

# --- command / tool execution limits --------------------------------------
AGENT_EXEC_DEFAULT_TIMEOUT_S=30
AGENT_EXEC_MAX_TIMEOUT_S=300
AGENT_MAX_OUTPUT_BYTES=1000000
AGENT_TOOL_SOURCE_MAX_BYTES=16384
AGENT_TOOL_TIMEOUT_S=30

# --- agent loop -----------------------------------------------------------
AGENT_MAX_STEPS=24
AGENT_MAX_HISTORY_MESSAGES=40
AGENT_SEARCH_K=5

# --- misc -----------------------------------------------------------------
AGENT_LOG_LEVEL=INFO
AGENT_RPC_TOKEN=

# --- network switch + firewall (the sandbox itself never gets a NIC) ---------
# net.fetch / net.http run in the AI service and hand bytes to the sandbox.
# 0 = off: hidden from search_tools and refused.  1 = only the hosts below.
AGENT_NET_ENABLED=0
# comma separated; *.example.com wildcards; a bare * allows everything (unsafe)
AGENT_NET_ALLOW_HOSTS=pypi.org,files.pythonhosted.org,hf-mirror.com,github.com,raw.githubusercontent.com,api.github.com,example.com
# ports the firewall lets through; anything else is refused even on an allowed host
AGENT_NET_ALLOW_PORTS=80,443
AGENT_NET_MAX_BYTES=8000000
AGENT_NET_TIMEOUT_S=30
AGENT_NET_MAX_REDIRECTS=3
# set to 1 only for tests that must reach a local server
AGENT_NET_ALLOW_PRIVATE_HOSTS=0

# --- personas ---------------------------------------------------------------
# engineer (default) | roleplay | teacher | reviewer | concise, or your own file
# in <repo>/personas/<name>.md (a file with the same name overrides the built-in)
AGENT_PERSONA=engineer
AGENT_PERSONA_DIR=

# --- permission tier (policy ceiling enforced by the AI service) ------------
# safe: sandbox tools only. trusted: + firewalled net.* and mcp.* tools.
# unrestricted: + host.exec on the machine running the control plane  [DANGER]
AGENT_PERMISSION_TIER=safe
# typing this exact phrase in the console (/perm unrestricted <phrase>) arms it
AGENT_HOST_EXEC_PHRASE=ENABLE-HOST-EXEC
# host.exec may only ever work inside this directory (empty = the repository root)
AGENT_HOST_WORKDIR=
AGENT_HOST_EXEC_TIMEOUT_S=60

# --- MCP (Streamable HTTP transport only) ----------------------------------
# stdio servers are not launched by the AI service (it may not spawn processes):
# expose them over HTTP and point this at the URL.
# AGENT_MCP_SERVERS={"demo": {"url": "http://10.0.2.2:8971/mcp"}}
AGENT_MCP_SERVERS=

# --- speech to text (local, faster-whisper) ---------------------------------
# The AI service transcribes audio bytes; the console posts files to POST /asr.
# Model sizes: tiny | base (~150 MB, default) | small (~500 MB, better Chinese) | medium
AGENT_ASR_ENABLED=true
AGENT_ASR_MODEL=base
AGENT_ASR_COMPUTE_TYPE=int8
# empty = auto-detect the spoken language; "zh" forces Chinese
AGENT_ASR_LANGUAGE=
AGENT_ASR_MAX_SECONDS=300
# refuse to reach the network for weights (the model must be pre-downloaded)
AGENT_ASR_LOCAL_ONLY=true

# --- images / model / reasoning effort --------------------------------------
# The gateway exposes deepseek-flash (text+image) and deepseek-v4-pro (text only);
# a turn carrying an image is routed to the vision model automatically.
AGENT_LLM_VISION_ENABLED=true
AGENT_LLM_VISION_MODEL=deepseek-flash
AGENT_LLM_MAX_IMAGES=4
AGENT_LLM_MAX_IMAGE_BYTES=8000000
# low | high | max, empty = do not send the field.  Its measured effect on this
# gateway is weak and noisy, so treat it as a hint rather than a guarantee.
AGENT_LLM_EFFORT=

# --- sandbox network switch (read the README before enabling) ---------------
# off  (default): the sandbox gets NO NIC at all.
# full: a slirp user-mode NIC -> the guest reaches the internet (apt, ping, DNS).
#       Egress allowed, ingress dropped; read-only root, non-root user, resource
#       limits and "no host shares" all still hold.
AGENT_SANDBOX_NET_MODE=off
